# Copy to .env.local and fill in from your Supabase project settings (API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/seed-users.mjs (never exposed to the browser/app).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The two allow-listed accounts. Change these before running the seed script.
PERSON_A_EMAIL=person-a@example.com
PERSON_A_PASSWORD=change-me-a
PERSON_A_NAME="Person A"
PERSON_B_EMAIL=person-b@example.com
PERSON_B_PASSWORD=change-me-b
PERSON_B_NAME="Person B"
